
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth.uid in [
        'zgCBWGAWP3TvCkjdABmixpJCI2u2'
      ];
    }

    // Users can read their own profile, admins can read all profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Alerts can be created by any user (SOS), but only read by authenticated users.
    // Only admins can update/delete.
    match /alerts/{alertId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();

      // Translations subcollection
      match /translations/{lang} {
         allow read: if request.auth != null;
         allow write: if false; // Only backend function can write
      }
    }
    
    // Users can update their own status, and all users can see statuses for the map.
    match /user_status/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth.uid == userId;
    }
    
    // Users can create feedback, only admins can read it.
    match /feedback/{feedbackId} {
        allow create: if request.auth != null;
        allow read, write, delete: if isAdmin();
    }
    
    // Users can create resource needs, all users can read them.
    // Only admins or the creator can update/delete.
    match /resource_needs/{needId} {
        allow read, create: if request.auth != null;
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
    }

    // Damage reports can be created by users.
    // Admins can read all reports. Users can read their own.
    match /damage_reports/{reportId} {
        allow create: if request.auth != null;
        allow read: if isAdmin() || request.auth.uid == resource.data.userId;
        allow update, delete: if isAdmin();
    }
    
    // Users can create missing person reports.
    // All users can read them (for matching).
    // Admins or the reporter can delete.
    match /missing_persons/{personId} {
        allow read, create: if request.auth != null;
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.reportedBy;
    }
    
    // Survivor stories can be created by authenticated users.
    // All users can read them.
    // Admins or the original poster can delete.
    match /survivor_stories/{storyId} {
        allow read, create: if request.auth != null;
        allow update, delete: if isAdmin() || request.auth.uid == resource.data.userId;
    }
  }
}
