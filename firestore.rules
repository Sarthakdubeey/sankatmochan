rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // Check if the user's UID is in the list of admin UIDs
      return request.auth.uid in [
        'zgCBWGAWP3TvCkjdABmixpJCI2u2'
      ];
    }

    // Rules for user profile documents
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth.uid == userId;
    }

    // Rules for alerts
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      // Allow creation if the user is authenticated OR if they are the creator.
      // This is more robust for new user sign-ups.
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    // Rules for damage reports
    match /damage_reports/{reportId} {
      allow create: if request.resource.data.userId == request.auth.uid;
      // Allow read if user is the owner or an admin
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
      allow list: if isAdmin();
    }

    // Rules for resource needs
    match /resource_needs/{needId} {
      allow read, write: if request.auth != null;
    }
    
    // Rules for user status updates
    match /user_status/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    
    // Rules for feedback
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.userId == request.auth.uid;
    }

    // Rules for survivor stories
    match /survivor_stories/{storyId} {
      allow read: if true; // Publicly readable
      allow create: if request.resource.data.userId == request.auth.uid;
    }
    
    // Rules for missing person reports
    match /missing_persons/{personId} {
        allow read: if true; // Publicly readable
        allow create: if request.resource.data.reportedBy == request.auth.uid;
    }
  }
}
