
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAdmin() {
      return request.auth.uid in get(/databases/$(database)/documents/configuration/admins).data.uids;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if request.auth != null;
      // Alternative: Ensure user can only create an alert for themselves.
      allow create: if request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if isAdmin();
      
      // Translations can be read by anyone, but only the Cloud Function can write them.
      match /translations/{lang} {
        allow read: if request.auth != null;
        allow write: if false; // Block client-side writes
      }
    }
    
    match /user_status/{userId} {
      allow read: if request.auth != null;
      // Users can only create or update their OWN status document
      allow write: if request.auth.uid == userId;
    }

    match /damage_reports/{reportId} {
        // Users can create their own reports
        allow create: if request.auth.uid == request.resource.data.userId;
        // Admins can read all reports for the dashboard
        allow list, get: if isAdmin();
        // Users can only read their own reports, admins can read any
        allow get: if request.auth.uid == resource.data.userId || isAdmin();
    }
    
    match /resource_needs/{needId} {
        allow create: if request.auth.uid == request.resource.data.userId;
        allow read: if request.auth != null;
        allow update: if isAdmin() || request.auth.uid == resource.data.userId;
    }
    
    match /survivor_stories/{storyId} {
        allow create: if request.auth.uid == request.resource.data.userId;
        allow read: if request.auth != null;
    }
    
    match /missing_persons/{personId} {
        allow create: if request.auth.uid == request.resource.data.reportedBy;
        allow read: if request.auth != null;
    }
    
    match /feedback/{feedbackId} {
        allow create: if request.auth.uid == request.resource.data.userId;
        // Only admins should be able to read feedback
        allow read: if isAdmin();
    }

    // This collection is read-only for the client.
    match /configuration/admins {
        allow read: if request.auth != null;
        allow write: if false;
    }
  }
}
